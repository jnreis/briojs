{
    "breadcrumbs.enabled": false,

    // Fonts I like: Menlo, JetBrains Mono, Operator Mono
    "editor.fontFamily": "'Operator Mono', Menlo, Monaco, 'Courier New', monospace",
    "editor.fontSize": 14,
    "editor.fontLigatures": false,

    "editor.cursorBlinking": "expand",
    "editor.cursorSmoothCaretAnimation": "on",

    "html.validate.styles": false,

    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": [
                    "comment",
                    "storage.type",
                    "storage.modifier",
                    "keyword.control",
                    "entity.other.attribute-name"
                ],
                "settings": {
                    "fontStyle": "italic"
                }
            }
        ]
    },
    "better-comments.tags": [
        {
            "tag": "!",
            "color": "#ed1516",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
        },
        {
            "tag": "?",
            "color": "#1696ec",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
        },
        {
            "tag": "//",
            "color": "#78716c",
            "strikethrough": true,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
        },
        {
            "tag": "*",
            "color": "#97da30",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
        },
        {
            "tag": "TODO",
            "color": "#fe9f2b",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
        },
        // Custom tags
        {
            "tag": "IMPORTANT",
            "color": "#ef4444",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": true,
            "italic": false
        },
        {
            "tag": "FIXME",
            "color": "#f97316",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": true,
            "italic": false
        },
        {
            "tag": "WIP",
            "color": "#f59e0b",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": true,
            "italic": false
        },
        {
            "tag": "WARNING",
            "color": "#eab308",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": true,
            "italic": false
        },
        {
            "tag": "REVIEW",
            "color": "#a855f7",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": true,
            "italic": false
        },
        {
            "tag": "OPTIMIZE",
            "color": "#d946ef",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": true,
            "italic": true
        },
        {
            "tag": "NOTE",
            "color": "#4ade80",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": true
        },
        {
            "tag": "TEST",
            "color": "#2dd4bf",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
        },
        {
            "tag": "EXAMPLE",
            "color": "#38bdf8",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": true
        },
        {
            "tag": "USAGE",
            "color": "#818cf8",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": true
        },
        {
            "tag": "LOG",
            "color": "#94a3b8",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": true
        }
    ]
}


/**
 * BETTER COMMENTS TAGS
 * ! IMPORTANT (icon: ❗)
 * ? QUESTION (icon: ❓)
 * * HIGHLIGHT (icon: 🌟)
 * // DISABLED (icon: 🚫)
 * TODO: action item (icon: 📌)
 * 
 * CUSTOM BETTER COMMENTS TAGS
 * IMPORTANT: something important (icon: ✨)
 * FIXME: something that needs to be fixed (icon: 🚨)
 * WIP: work in progress (icon: 🚧)
 * WARNING: something that needs attention (icon: ⚠️)
 * REVIEW: something that needs review (icon: 👀)
 * OPTIMIZE: something that needs to be optimized (icon: 📈)
 * 
 * NOTE: a general note (icon: 📝)
 * TEST: something that needs to be tested (icon: 🧪)
 * EXAMPLE: example information (icon: 💡)
 * USAGE: usage information (icon: 🚀)
 * LOG: a log that should be removed (icon: 📜)
 */