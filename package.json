{
  "name": "@jnreis/briojs",
  "version": "4.0.0",
  "description": "A petite, HTML-first framework for reactive widgets and web apps.",
  "author": {
    "name": "Jonathan Reis",
    "email": "jonathan@briojs.com"
  },
  "homepage": "https://briojs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jnreis/briojs.git"
  },
  "bugs": {
    "url": "https://github.com/jnreis/briojs/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "brio",
    "briojs",
    "javascript",
    "typescript",
    "framework",
    "ui",
    "frontend",
    "declarative",
    "reactive",
    "dom"
  ],
  "files": [
    "dist",
    "ai",
    "README.md",
    "DOCUMENTATION.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./reactivity": {
      "types": "./dist/reactivity-entry.d.ts",
      "import": "./dist/reactivity.js"
    },
    "./persistence": {
      "types": "./dist/persistence-entry.d.ts",
      "import": "./dist/persistence-entry.js"
    },
    "./router": {
      "types": "./dist/router-entry.d.ts",
      "import": "./dist/router-entry.js"
    },
    "./devtools": {
      "types": "./dist/devtools-entry.d.ts",
      "import": "./dist/devtools-entry.js"
    },
    "./http": {
      "types": "./dist/http-entry.d.ts",
      "import": "./dist/http-entry.js"
    },
    "./forms": {
      "types": "./dist/forms-entry.d.ts",
      "import": "./dist/forms-entry.js"
    },
    "./step": {
      "types": "./dist/step-entry.d.ts",
      "import": "./dist/step-entry.js"
    },
    "./money-mask": {
      "types": "./dist/money-mask-entry.d.ts",
      "import": "./dist/money-mask-entry.js"
    },
    "./astro": {
      "types": "./dist/astro-entry.d.ts",
      "import": "./dist/astro-entry.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "sideEffects": [
    "./src/devtools-entry.ts",
    "./dist/devtools-entry.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.js",
    "site:prepare": "node site/scripts/prepare.mjs",
    "site:dev": "npm run build && npm run site:prepare && astro dev --root site",
    "site:build": "npm run build && npm run site:prepare && astro build --root site",
    "site:preview": "astro preview --root site",
    "test:site": "playwright test --config tests/site/playwright.config.js",
    "test:playground": "playwright test --config tests/playground/playwright.config.js",
    "prepack": "npm run build",
    "size": "node scripts/size.js",
    "test": "npm run build && node --test",
    "typecheck": "tsc --noEmit",
    "dev:astro": "astro dev --root tests/fixtures/astro --host 127.0.0.1 --port 4321",
    "test:astro": "npm run build && playwright test --config tests/astro/playwright.config.js",
    "bench": "npm run build && node bench/run.mjs",
    "bench:compare": "npm run build && node bench/run.mjs --compare",
    "bench:check": "npm run build && node bench/run.mjs --check"
  },
  "devDependencies": {
    "@astrojs/starlight": "0.37.7",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.10.10",
    "alpinejs": "^3.17.5",
    "astro": "5.18.2",
    "esbuild": "0.21.5",
    "github-slugger": "2.0.0",
    "jsdom": "^26.1.0",
    "petite-vue": "0.4.1",
    "preact": "^10.29.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-parse": "11.0.0",
    "svelte": "^5.57.2",
    "typescript": "^5.7.3",
    "unified": "11.0.5",
    "vite": "^5.0.8",
    "vite-plugin-dts": "^3.8.1",
    "vue": "^3.5.44"
  }
}
